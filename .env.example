# Vicidial (alpha1)
VICIDIAL_USER=your_username
VICIDIAL_PASSWORD=your_password_here

# --- WhatsApp provider: set WHATSAPP_PROVIDER and matching vars below ---
# Options: evolution | twilio | webhook | green_api | console

WHATSAPP_PROVIDER=green_api

# Regular updates (one group)
WHATSAPP_TO=120363028290712457@g.us

# Mon-Fri Tea_Time, Lunch_Time, 2nd_Time (both groups)
WHATSAPP_TO_LUNCH_EOD=120363028290712457@g.us,120363146984037888@g.us

# Option A: Evolution API (best Green API replacement; supports groups + PNG)
EVOLUTION_API_URL=https://your-evolution-server.com
EVOLUTION_API_KEY=your_api_key
EVOLUTION_INSTANCE=your_instance_name

# Option B: Twilio WhatsApp (text; images need extra Twilio media setup)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Option C: Your own HTTP endpoint (POST JSON or multipart image)
# WHATSAPP_WEBHOOK_URL=https://your-server/send-whatsapp

# Option D: Green API (legacy)
GREEN_API_URL=https://7107.api.greenapi.com
GREEN_API_INSTANCE_ID=7107659529
GREEN_API_TOKEN=your_green_api_token
